        <mxCell id="nsFlow" parent="1" style="text;html=1;fontSize=10;fontColor=#64748B;align=left;" value="in-cluster flows:  Filebeat → Elasticsearch → Kibana  ·  Prometheus → Grafana (datasource)  ·  Prometheus → Alertmanager" vertex="1">
