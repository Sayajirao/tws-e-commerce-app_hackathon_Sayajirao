        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" value="LEGEND — flows&lt;br&gt;&lt;br&gt;🔵 blue — user request:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;user → IGW → ALB → pod (by path)&lt;br&gt;🟠 orange — CI: push → build → Trivy&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ Docker Hub → tag committed back&lt;br&gt;🟢 green — GitOps: Argo CD pulls from&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;GitHub &amp;amp; applies manifests&lt;br&gt;🟣 purple — operator: kubectl/terraform&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(API endpoint is IP-allowlisted)&lt;br&gt;🔴 red — Alertmanager e-mail alerts&lt;br&gt;⚪ gray dashed — image pulls via NAT&lt;br&gt;&lt;br&gt;&lt;br&gt;ALB PATH ROUTING (group.order):&lt;br&gt;&amp;nbsp;&amp;nbsp;/grafana → Grafana (10)&lt;br&gt;&amp;nbsp;&amp;nbsp;/argocd → Argo CD (11)&lt;br&gt;&amp;nbsp;&amp;nbsp;/kibana → Kibana (12)&lt;br&gt;&amp;nbsp;&amp;nbsp;/prometheus → Prometheus (13)&lt;br&gt;&amp;nbsp;&amp;nbsp;/ → EasyShop app (100, catch-all LAST)&lt;br&gt;&lt;br&gt;WHY EACH TOOL:&lt;br&gt;&amp;nbsp;&amp;nbsp;Terraform = provision · Argo CD = deploy&lt;br&gt;&amp;nbsp;&amp;nbsp;Prometheus/Grafana = metrics &amp;amp; dashboards&lt;br&gt;&amp;nbsp;&amp;nbsp;ELK = logs · Trivy = image CVE scanning&lt;br&gt;&amp;nbsp;&amp;nbsp;HPA + metrics-server = autoscaling" vertex="1">
          <mxGeometry height="510" width="400" x="1500" y="-482" as="geometry" />
        </mxCell>
        <mxCell id="Nv-8smx2dU-fUxgZ5PAD-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;color: rgb(35, 47, 62); font-size: 11px; font-weight: 700; white-space: nowrap;&quot;&gt;End User&lt;/span&gt;&lt;br style=&quot;color: rgb(35, 47, 62); font-size: 11px; font-weight: 700; white-space: nowrap;&quot;&gt;&lt;span style=&quot;color: rgb(35, 47, 62); font-size: 11px; font-weight: 700; white-space: nowrap;&quot;&gt;(browser · HTTP)&lt;/span&gt;" vertex="1">
