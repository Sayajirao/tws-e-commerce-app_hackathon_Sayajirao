# ---- Terraform ----
# Provider plugins & module cache (large, machine-specific)
**/.terraform/*

# State files (may contain secrets; we use the S3 backend instead)
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files that often hold secrets
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan

# ---- Secrets / keys ----
# Auto-generated SSH private key for Jenkins/Bastion — NEVER commit
terra-key.pem
*.pem
*.key

# ---- Node.js / Next.js (application) ----
node_modules/
/.pnp
.pnp.js
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo
coverage/
.eslintcache

# Real env files — keep secrets OUT of git. Commit only .env.example.
.env
.env.local
.env.development
.env.test
.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
.vscode/
.idea/
