# Copy this file to .env.local and fill in real values. Do NOT commit .env.local.

# Database Configuration
MONGODB_URI=mongodb://easyshop-mongodb:27017/easyshop

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000          # Replace with your server's URL in production
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Secrets — generate your own, do NOT reuse these placeholders.
#   openssl rand -base64 32   -> NEXTAUTH_SECRET
#   openssl rand -hex 32      -> JWT_SECRET
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
JWT_SECRET=<generate-with-openssl-rand-hex-32>
